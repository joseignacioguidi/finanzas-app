meta {
  name: Crear transacción
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "category_id": "{{categoryId}}",
    "type": "expense",
    "amount": 1500,
    "currency": "ARS",
    "description": "Almuerzo",
    "date": "2026-04-27"
  }
}

script:post-response {
  const data = res.getBody();
  if (data.id) {
    bru.setVar("transactionId", data.id);
    console.log("transactionId guardado:", data.id);
  }
}
