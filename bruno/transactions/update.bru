meta {
  name: Editar transacción
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/transactions/{{transactionId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "category_id": "{{categoryId}}",
    "type": "expense",
    "amount": 2000,
    "currency": "ARS",
    "description": "Almuerzo actualizado",
    "date": "2026-04-27"
  }
}
